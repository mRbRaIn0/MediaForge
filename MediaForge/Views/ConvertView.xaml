<UserControl x:Class="MediaForge.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PowerBackground}"
             KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ViewHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource PowerGhostButton}"
                        AutomationProperties.Name="Zurück zum Hauptmenü">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                        <TextBlock Text="Hauptmenü"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border Width="3" Height="22" CornerRadius="2" Background="{StaticResource ModuleConvert}" Margin="0,0,11,0"/>
                    <TextBlock Text="Convert" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Format wechseln und defekte Videos reparieren"
                               Foreground="{StaticResource PowerMuted}" FontSize="11.5" Margin="12,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding AddFilesCommand}"
                        Style="{StaticResource PowerButton}"
                        AutomationProperties.Name="Dateien auswählen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#9EB9FF" Margin="0,0,7,0"/>
                        <TextBlock Text="Dateien auswählen"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="278"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="14,12,7,14"
                    Style="{StaticResource PowerCardStyle}"
                    Background="{StaticResource PowerSidebar}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,18,18">
                        <TextBlock Text="Steuerung" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,12"/>

                        <Button Command="{Binding StartCommand}"
                                Style="{StaticResource PowerPrimaryButton}"
                                AutomationProperties.Name="Konvertierung starten">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="Konvertieren"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddFilesCommand}"
                                Style="{StaticResource PowerButton}"
                                Margin="0,10,0,0"
                                AutomationProperties.Name="Dateien zur Warteschlange hinzufügen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="Hinzufügen"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource PowerBorder}" Margin="0,14,0,14"/>

                        <TextBlock Text="Zielformat" Style="{StaticResource FieldLabel}" Margin="2,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" AutomationProperties.Name="Zielformat"/>

                        <TextBlock Text="Encoder / Modus" Style="{StaticResource FieldLabel}" Margin="2,11,0,5"/>
                        <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding Encoder}" AutomationProperties.Name="Encoder oder Modus"/>

                        <CheckBox Content="Nur inkompatible reparieren"
                                  IsChecked="{Binding OnlyBroken}"
                                  IsEnabled="{Binding IsRepairMode}"
                                  Margin="0,14,0,1"
                                  ToolTip="Nur im Reparatur-Modus verfügbar"
                                  AutomationProperties.Name="Nur inkompatible Dateien reparieren"/>
                        <CheckBox Content="Eigener Zielordner"
                                  IsChecked="{Binding UseCustomFolder}"
                                  AutomationProperties.Name="Eigenen Zielordner verwenden"/>

                        <Button Command="{Binding ChooseFolderCommand}"
                                IsEnabled="{Binding UseCustomFolder}"
                                Style="{StaticResource PowerButton}"
                                Margin="0,9,0,0"
                                AutomationProperties.Name="Zielordner wählen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="Ordner wählen"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding OutputFolder}"
                                   Style="{StaticResource MetaText}"
                                   TextWrapping="Wrap"
                                   Margin="2,7,0,0"
                                   ToolTip="{Binding OutputFolder}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="7,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="198"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PowerCardStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Warteschlange" FontWeight="SemiBold" FontSize="14"/>
                            <Border Grid.Column="1" Background="{StaticResource PowerRow}" CornerRadius="5" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Jobs.Count}" Foreground="{StaticResource PowerMuted}" FontFamily="Consolas" FontSize="10.5"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{StaticResource PowerBorderSoft}" BorderThickness="0,1,0,0">
                            <Grid Margin="16,10,16,16">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Jobs.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Rectangle Stroke="#35404F" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="11" RadiusY="11"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="54" Height="54" Margin="0,0,0,18">
                                            <Path Data="M 6,10 A 10,10 0 0 1 26,10 M 26,22 A 10,10 0 0 1 6,22 M 26,4 L 26,10 L 20,10 M 6,28 L 6,22 L 12,22"
                                                  Stroke="#D7DCE5" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Viewbox>
                                        <TextBlock Text="Keine Dateien in der Warteschlange" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Füge Videos hinzu, wähle Zielformat und Encoder,&#x0a;und starte die Konvertierung."
                                                   Foreground="{StaticResource PowerMuted}"
                                                   TextAlignment="Center"
                                                   LineHeight="20"
                                                   FontSize="12.5"
                                                   Margin="0,8,0,18"/>
                                        <Button Command="{Binding AddFilesCommand}"
                                                Style="{StaticResource PowerLinkButton}"
                                                Padding="15,8"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="Dateien hinzufügen">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="#6F9AFF" Margin="0,0,7,0"/>
                                                <TextBlock Text="Dateien hinzufügen" Foreground="#6F9AFF"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ListBox ItemsSource="{Binding Jobs}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PowerRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number, StringFormat='#{0}'}" Foreground="#7FA3FA" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="7,0,12,0" ToolTip="{Binding FilePath}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CodecText}" Style="{StaticResource MetaText}" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold"/>
                                                    <Button Grid.Column="4"
                                                            Content="&#xE74D;"
                                                            Style="{StaticResource PowerIconDangerButton}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Aus Warteschlange entfernen"
                                                            AutomationProperties.Name="Datei aus Warteschlange entfernen"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PowerCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="49"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ausgabe / Log" FontWeight="SemiBold" FontSize="13.5"/>
                            <Border Grid.Column="1"
                                    Background="#2E2A1E"
                                    BorderBrush="#574E2E"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,3"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Konvertierung läuft…" Foreground="{StaticResource PowerWarning}" FontSize="11"/>
                            </Border>
                        </Grid>
                        <TextBox x:Name="LogBox"
                                 Grid.Row="1"
                                 Margin="16,0,16,16"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 Style="{StaticResource PowerTerminalBox}"
                                 TextChanged="LogBox_TextChanged"
                                 AutomationProperties.Name="Konvertierungsprotokoll"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
