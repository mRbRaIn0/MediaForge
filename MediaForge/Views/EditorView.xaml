<UserControl x:Class="MediaForge.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MediaForge.Controls"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             Unloaded="OnUnloaded"
             Background="{StaticResource PowerBackground}">
    <UserControl.Resources>
        <!-- Listenzeile mit sichtbarer Auswahl -->
        <Style x:Key="SelectableRow" TargetType="Border" BasedOn="{StaticResource PowerRowStyle}">
            <Setter Property="Padding" Value="10,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="#26303E"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ModuleEditor}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PowerMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <Style x:Key="MarkerButton" TargetType="Button" BasedOn="{StaticResource PowerButton}">
            <Setter Property="Background" Value="#2B2740"/>
            <Setter Property="BorderBrush" Value="#4A4270"/>
            <Setter Property="Foreground" Value="{StaticResource ModuleEditor}"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ViewHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource PowerGhostButton}"
                        AutomationProperties.Name="Zurück zum Hauptmenü">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                        <TextBlock Text="Hauptmenü"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border Width="3" Height="22" CornerRadius="2" Background="{StaticResource ModuleEditor}" Margin="0,0,11,0"/>
                    <TextBlock Text="Editor" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Marker setzen, Abschnitte zusammenstellen, exportieren"
                               Foreground="{StaticResource PowerMuted}" FontSize="11.5" Margin="12,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding ChooseFileCommand}"
                        Style="{StaticResource PowerButton}"
                        AutomationProperties.Name="Video wählen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#9EB9FF" Margin="0,0,7,0"/>
                        <TextBlock Text="Video wählen"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1140" Margin="16,14,16,16">

                <!-- ============ Vorschau & Zeitleiste ============ -->
                <Border Style="{StaticResource PowerCardStyle}" Padding="16,14">
                    <StackPanel>
                        <Border Height="300" Background="{StaticResource PowerTerminal}" CornerRadius="9" ClipToBounds="True">
                            <Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Rectangle Margin="14" Stroke="#35404F" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="9" RadiusY="9"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="50" Height="50" Margin="0,0,0,16">
                                            <Path Data="M 6,8 L 26,8 L 26,24 L 6,24 Z M 6,14 L 26,14 M 12,14 L 12,24 M 19,14 L 19,24 M 12,8 L 12,14 M 19,8 L 19,14"
                                                  Stroke="#D7DCE5" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Viewbox>
                                        <TextBlock Text="Kein Video geladen" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Wähle eine Datei — Marker und Schnittliste werden aus der&#x0a;Datei „name.mediaforge.json“ daneben geladen."
                                                   Foreground="{StaticResource PowerMuted}" TextAlignment="Center" LineHeight="19" FontSize="12.5" Margin="0,7,0,16"/>
                                        <Button Command="{Binding ChooseFileCommand}"
                                                Style="{StaticResource PowerPrimaryButton}"
                                                MinWidth="180"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="Video wählen">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                                <TextBlock Text="Video wählen"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                                <MediaElement x:Name="Player"
                                              Visibility="Collapsed"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="Uniform"/>
                            </Grid>
                        </Border>

                        <Grid Margin="2,12,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding MediaSummary}" Style="{StaticResource MetaText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Background="{StaticResource PowerTerminal}" BorderBrush="#333D49" BorderThickness="1"
                                        CornerRadius="6" Padding="11,6" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PositionText}" FontFamily="Consolas" FontSize="12.5"
                                               Foreground="{StaticResource ModuleEditor}" FontWeight="SemiBold"
                                               AutomationProperties.Name="Aktuelle Abspielposition"/>
                                </Border>
                                <Button Click="Play_Click" MinWidth="130" AutomationProperties.Name="Abspielen oder pausieren">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PlayText" Text="Abspielen"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Stop_Click" MinWidth="96" Margin="8,0,0,0" AutomationProperties.Name="Wiedergabe stoppen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                        <TextBlock Text="Stop"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource PowerTerminal}" BorderBrush="#333D49" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <controls:TimelineControl x:Name="Timeline"
                                                      Height="140"
                                                      Duration="{Binding Duration}"
                                                      Position="{Binding Position, Mode=TwoWay}"
                                                      Thumbnails="{Binding Thumbnails}"
                                                      Markers="{Binding Markers}"
                                                      Clips="{Binding Clips}"
                                                      SelectedMarker="{Binding SelectedMarker}"
                                                      SeekRequested="Timeline_SeekRequested"
                                                      MarkerClicked="Timeline_MarkerClicked"/>
                        </Border>

                        <TextBlock Style="{StaticResource HintText}" Margin="2,9,0,0"
                                   Text="Tasten:  M Punkt-Marker · Umschalt+M Bereich · S Clip teilen · Entf Clip entfernen · Leertaste Abspielen/Pause · ← → 1 Sekunde springen"/>
                    </StackPanel>
                </Border>

                <!-- ============ Schnittliste & Marker ============ -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="490"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="0,0,5,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Schnittliste" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Border Background="{StaticResource PowerRow}" CornerRadius="5" Padding="8,3" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ClipSummary}" Foreground="{StaticResource PowerMuted}" FontFamily="Consolas" FontSize="10.5"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,11,0,11">
                                <Button Command="{Binding SplitClipCommand}" MinWidth="150" AutomationProperties.Name="Clip an der Abspielposition teilen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ModuleEditor}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Teilen  (S)"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetClipsCommand}" Content="Zurücksetzen" MinWidth="130" Margin="8,0,0,0"
                                        ToolTip="Wieder ein Clip über das ganze Video" AutomationProperties.Name="Schnittliste zurücksetzen"/>
                                <Button Command="{Binding ClearClipsCommand}" Content="Leeren" MinWidth="96" Margin="8,0,0,0"
                                        ToolTip="Alle Clips entfernen — danach z. B. Bereich-Marker übernehmen"
                                        AutomationProperties.Name="Schnittliste leeren"/>
                            </StackPanel>

                            <Grid Grid.Row="2" MinHeight="180">
                                <TextBlock VerticalAlignment="Top"
                                           Text="Keine Clips. „Zurücksetzen“ legt das ganze Video als einen Clip an, oder übernimm einen Bereich-Marker als Clip.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasClips}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox x:Name="ClipList" ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}"
                                         SelectionChanged="ClipList_SelectionChanged" MaxHeight="300"
                                         AutomationProperties.Name="Clips">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SelectableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#7C9CFF" CornerRadius="5" Width="24" Height="20" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Number}" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11.5"/>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MetaText}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource MetaText}" Margin="0,0,10,0"/>
                                                        <Button Content="&#xE74A;" Style="{StaticResource PowerIconButton}"
                                                                Command="{Binding DataContext.MoveClipUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Nach oben" AutomationProperties.Name="Clip nach oben"/>
                                                        <Button Content="&#xE74B;" Style="{StaticResource PowerIconButton}" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.MoveClipDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Nach unten" AutomationProperties.Name="Clip nach unten"/>
                                                        <Button Content="&#xE74D;" Style="{StaticResource PowerIconDangerButton}" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.RemoveClipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Clip entfernen" AutomationProperties.Name="Clip entfernen"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="5,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Marker" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Border Background="{StaticResource PowerRow}" CornerRadius="5" Padding="8,3" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding MarkerSummary}" Foreground="{StaticResource PowerMuted}" FontFamily="Consolas" FontSize="10.5"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,11,0,0">
                                <Button Command="{Binding AddPointMarkerCommand}" Style="{StaticResource MarkerButton}"
                                        AutomationProperties.Name="Punkt-Marker an aktueller Position setzen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                        <TextBlock Text="Marker  (M)"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddRangeMarkerCommand}" Style="{StaticResource MarkerButton}" Margin="8,0,0,0"
                                        AutomationProperties.Name="Bereich-Marker anlegen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                        <TextBlock Text="Bereich  (Shift+M)"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBox Grid.Row="2" Text="{Binding MarkerFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,11"
                                     ToolTip="Nach Titel, Notiz, Tag, Kategorie oder Zeit suchen"
                                     AutomationProperties.Name="Marker durchsuchen"/>

                            <Grid Grid.Row="3" MinHeight="180">
                                <TextBlock VerticalAlignment="Top"
                                           Text="Noch keine Marker. Video abspielen und an der gewünschten Stelle M drücken — der Marker landet sofort auf der Zeitleiste und in der JSON-Datei.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMarkers}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox x:Name="MarkerList" ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedMarker}"
                                         SelectionChanged="MarkerList_SelectionChanged" MouseDoubleClick="MarkerList_MouseDoubleClick"
                                         MaxHeight="300" AutomationProperties.Name="Marker">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SelectableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="3" CornerRadius="2" Background="{Binding CategoryColor}" Margin="0,1,10,1"/>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                                                       Foreground="{Binding CategoryColor}"/>
                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource MetaText}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="&#xE70F;" Style="{StaticResource PowerIconButton}"
                                                                Command="{Binding DataContext.EditMarkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Marker bearbeiten" AutomationProperties.Name="Marker bearbeiten"/>
                                                        <Button Content="&#xE710;" Style="{StaticResource PowerIconButton}" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.ClipFromMarkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Bereich als Clip in die Schnittliste übernehmen"
                                                                AutomationProperties.Name="Bereich als Clip übernehmen"
                                                                Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}"/>
                                                        <Button Content="&#xE74D;" Style="{StaticResource PowerIconDangerButton}" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.DeleteMarkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Marker löschen" AutomationProperties.Name="Marker löschen"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ Metadaten der Datei ============ -->
                <Border Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Metadaten (JSON neben dem Video)" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Titel" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding Sidecar.Title}" IsEnabled="{Binding HasSidecar}"
                                     AutomationProperties.Name="Titel der Datei"/>
                            <TextBlock Grid.Column="2" Text="Tags" Style="{StaticResource FieldLabel}" Margin="16,0,10,0"/>
                            <TextBox Grid.Column="3" Text="{Binding Sidecar.TagsText}" IsEnabled="{Binding HasSidecar}"
                                     ToolTip="Datei-Tags, mit Leerzeichen oder Komma getrennt"
                                     AutomationProperties.Name="Tags der Datei"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Beschreibung" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding Sidecar.Description}" IsEnabled="{Binding HasSidecar}"
                                     AutomationProperties.Name="Beschreibung der Datei"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Datei" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SidecarPathText}" Style="{StaticResource MetaText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SidecarPathText}"/>
                            <Button Grid.Column="2" Command="{Binding OpenSidecarFolderCommand}" Content="Im Ordner zeigen" Margin="12,0,0,0"
                                    AutomationProperties.Name="Sidecar-Datei im Ordner zeigen"/>
                            <Button Grid.Column="3" Command="{Binding SaveSidecarCommand}" Margin="8,0,0,0"
                                    AutomationProperties.Name="Metadaten speichern">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                    <TextBlock Text="Speichern"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource HintText}" Margin="92,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============ Ausgabe & Export ============ -->
                <Border Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Ausgabe &amp; Export" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dateiname" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Dateiname der Ausgabe"/>
                            <CheckBox Grid.Column="2" Content="Exakter Schnitt (neu encodieren)" IsChecked="{Binding Exact}" Margin="16,0,0,0"
                                      ToolTip="Schneidet framegenau, dauert aber länger"
                                      AutomationProperties.Name="Exakter Schnitt mit Neuencodierung"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zielordner" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding OutputFolder}" Style="{StaticResource MetaText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolder}"/>
                            <Button Grid.Column="2" Command="{Binding ChooseFolderCommand}" Content="Ordner wählen" Margin="16,0,0,0"
                                    AutomationProperties.Name="Zielordner wählen"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding ExportCommand}" Style="{StaticResource PowerPrimaryButton}" MinWidth="190"
                                    AutomationProperties.Name="Schnittliste exportieren">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                    <TextBlock Text="Schnittliste exportieren"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding ExportMarkerCommand}" CommandParameter="{Binding SelectedMarker}"
                                    MinWidth="190" Margin="8,0,0,0"
                                    ToolTip="Exportiert den ausgewählten Bereich-Marker als eigene Datei"
                                    AutomationProperties.Name="Ausgewählten Bereich exportieren">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                    <TextBlock Text="Bereich exportieren"/>
                                </StackPanel>
                            </Button>
                            <ProgressBar Grid.Column="2" Style="{StaticResource PowerProgress}" Value="{Binding Progress, Mode=OneWay}"
                                         Maximum="1" Margin="16,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{StaticResource PowerMuted}" FontSize="11.5"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
