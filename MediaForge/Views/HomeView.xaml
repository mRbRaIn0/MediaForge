<UserControl x:Class="MediaForge.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PowerBackground}">
    <UserControl.Resources>
        <!-- Modulkachel: ruhige Karte, Modulfarbe nur als Akzent und beim Hover -->
        <Style x:Key="ModuleTile" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Width="196"
                                Height="196"
                                Background="{StaticResource PowerCard}"
                                BorderBrush="{StaticResource PowerBorderSoft}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Border x:Name="Accent"
                                        Width="34"
                                        Height="3"
                                        CornerRadius="2"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Margin="0,15,0,0"
                                        Background="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#212A36"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Accent" Property="Width" Value="58"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#80A4FF"/>
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Opacity" Value=".78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Breite Kachel der Bibliothek: liegt quer über der Werkzeugreihe -->
        <Style x:Key="GalleryBanner" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,6,14"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MaxWidth" Value="1456"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Banner"
                                Height="104"
                                Background="{StaticResource PowerCard}"
                                BorderBrush="{StaticResource PowerBorderSoft}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Border x:Name="Accent"
                                        Width="34"
                                        Height="3"
                                        CornerRadius="2"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Margin="0,15,0,0"
                                        Background="{TemplateBinding Foreground}"/>
                                <!-- Waagerecht gestreckt, damit die Spalten des Inhalts die volle Breite teilen
                                     und die mittlere Spalte wirklich in der Bannermitte sitzt. -->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Banner" Property="Background" Value="#212A36"/>
                                <Setter TargetName="Banner" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Accent" Property="Width" Value="58"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Banner" Property="BorderBrush" Value="#80A4FF"/>
                                <Setter TargetName="Banner" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Banner" Property="Opacity" Value=".78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PowerText}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,13,0,0"/>
        </Style>
        <Style x:Key="TileHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PowerMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="StatusLine" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PowerMuted}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,0" MinHeight="{Binding ViewportHeight, ElementName=Scroller}">
            <StackPanel VerticalAlignment="Center">

            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,34">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="22" Height="3" CornerRadius="2" Background="{StaticResource PowerPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Fotos | Videos | Manager | Editor"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PowerPrimary}"
                               Margin="11,0,11,0"/>
                    <Border Width="22" Height="3" CornerRadius="2" Background="{StaticResource PowerPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="MediaForge" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="Herunterladen · Schneiden · Marker · Konvertieren · Tempo · Verbinden · Sortieren"
                           FontSize="14.5"
                           Foreground="{StaticResource PowerMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <!-- Die Bibliothek liegt quer über den Werkzeugen — sie ordnet, was die Werkzeuge erzeugen. -->
            <Button Command="{Binding NavigateCommand}" CommandParameter="gallery"
                    Style="{StaticResource GalleryBanner}"
                    Foreground="{StaticResource ModuleGallery}"
                    AutomationProperties.Name="Galerie öffnen">
                <!-- Der Text steht in der mittleren Spalte und damit genau unter dem Akzentstrich;
                     das Symbol lehnt sich von links an, ohne die Mitte zu verschieben. -->
                <Grid Margin="24,10,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEB9F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="32"
                               Foreground="{StaticResource ModuleGallery}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Galerie" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ordner einlesen · Zeitleiste · Suche · Alben · Tags · Favoriten"
                                   Foreground="{StaticResource PowerMuted}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <WrapPanel HorizontalAlignment="Center">
                <Button Command="{Binding NavigateCommand}" CommandParameter="download"
                        Style="{StaticResource ModuleTile}"
                        Foreground="{StaticResource ModuleDownload}"
                        AutomationProperties.Name="yt-dlp öffnen">
                    <StackPanel>
                        <TextBlock Text="&#xE896;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource ModuleDownload}"/>
                        <TextBlock Text="yt-dlp" Style="{StaticResource TileName}"/>
                        <TextBlock Text="Videos &amp; Audio&#x0a;herunterladen" Style="{StaticResource TileHint}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="cut"
                        Style="{StaticResource ModuleTile}"
                        Foreground="{StaticResource ModuleCut}"
                        AutomationProperties.Name="Cut öffnen">
                    <StackPanel>
                        <TextBlock Text="&#xE8C6;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource ModuleCut}"/>
                        <TextBlock Text="Cut" Style="{StaticResource TileName}"/>
                        <TextBlock Text="Verlustfrei&#x0a;schneiden" Style="{StaticResource TileHint}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="editor"
                        Style="{StaticResource ModuleTile}"
                        Foreground="{StaticResource ModuleEditor}"
                        AutomationProperties.Name="Editor öffnen">
                    <StackPanel>
                        <TextBlock Text="&#xE7C1;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource ModuleEditor}"/>
                        <TextBlock Text="Editor" Style="{StaticResource TileName}"/>
                        <TextBlock Text="Marker setzen &amp;&#x0a;Clips zusammenstellen" Style="{StaticResource TileHint}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="convert"
                        Style="{StaticResource ModuleTile}"
                        Foreground="{StaticResource ModuleConvert}"
                        AutomationProperties.Name="Convert öffnen">
                    <StackPanel>
                        <TextBlock Text="&#xE895;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource ModuleConvert}"/>
                        <TextBlock Text="Convert" Style="{StaticResource TileName}"/>
                        <TextBlock Text="Konvertieren &amp;&#x0a;Videos reparieren" Style="{StaticResource TileHint}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="speed"
                        Style="{StaticResource ModuleTile}"
                        Foreground="{StaticResource ModuleSpeed}"
                        AutomationProperties.Name="Speed Zone öffnen">
                    <StackPanel>
                        <TextBlock Text="&#xE89A;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource ModuleSpeed}"/>
                        <TextBlock Text="Speed Zone" Style="{StaticResource TileName}"/>
                        <TextBlock Text="Abschnitte schneller&#x0a;oder langsamer" Style="{StaticResource TileHint}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="link"
                        Style="{StaticResource ModuleTile}"
                        Foreground="{StaticResource ModuleLink}"
                        AutomationProperties.Name="Link öffnen">
                    <StackPanel>
                        <TextBlock Text="&#xE71B;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource ModuleLink}"/>
                        <TextBlock Text="Link" Style="{StaticResource TileName}"/>
                        <TextBlock Text="Videos zu einem&#x0a;zusammenfügen" Style="{StaticResource TileHint}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="sorter"
                        Style="{StaticResource ModuleTile}"
                        Foreground="{StaticResource ModuleSorter}"
                        AutomationProperties.Name="Sorter öffnen">
                    <StackPanel>
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource ModuleSorter}"/>
                        <TextBlock Text="Sorter" Style="{StaticResource TileName}"/>
                        <TextBlock Text="Dateien per Taste&#x0a;in Ordner einsortieren" Style="{StaticResource TileHint}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <StackPanel HorizontalAlignment="Center" Margin="0,34,0,0" MaxWidth="620">
                <Button Click="OpenSettings_Click"
                        Style="{StaticResource PowerButton}"
                        MinWidth="330"
                        AutomationProperties.Name="Einstellungen öffnen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                        <TextBlock Text="Einstellungen"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Pfade zu yt-dlp, ffmpeg, Zielordner und Cookies festlegen"
                           Foreground="{StaticResource PowerMuted}"
                           FontSize="11.5"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
                <Border Background="{StaticResource PowerCard}"
                        BorderBrush="{StaticResource PowerBorderSoft}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14,10"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding OutputStatus}" Style="{StaticResource StatusLine}" Margin="0" ToolTip="{Binding OutputStatus}"/>
                        <TextBlock Text="{Binding YtDlpStatus}" Style="{StaticResource StatusLine}" ToolTip="{Binding YtDlpStatus}"/>
                        <TextBlock Text="{Binding FfmpegStatus}" Style="{StaticResource StatusLine}" ToolTip="{Binding FfmpegStatus}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
