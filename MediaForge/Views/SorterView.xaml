<UserControl x:Class="MediaForge.Views.SorterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             Background="{StaticResource PowerBackground}">
    <UserControl.Resources>
        <!-- Zielbereich: eine Zeile aus Tastenkappe, Name und Ordner -->
        <Style x:Key="TargetButton" TargetType="Button" BasedOn="{StaticResource PowerButton}">
            <Setter Property="Background" Value="{StaticResource PowerRow}"/>
            <Setter Property="BorderBrush" Value="#2F3947"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="MinHeight" Value="52"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ModuleSorter}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#2B3543"/>
            <Setter Property="BorderBrush" Value="#404C5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ModuleSorter}"/>
        </Style>

        <Style x:Key="LegendKey" TargetType="Border">
            <Setter Property="Background" Value="#2B3543"/>
            <Setter Property="BorderBrush" Value="#404C5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PowerMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource PowerButton}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid IsEnabled="{Binding IsIdle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Kopfzeile ===================== -->
        <Border Style="{StaticResource ViewHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource PowerGhostButton}"
                        AutomationProperties.Name="Zurück zum Hauptmenü">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                        <TextBlock Text="Hauptmenü"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border Width="3" Height="22" CornerRadius="2" Background="{StaticResource ModuleSorter}" Margin="0,0,11,0"/>
                    <TextBlock Text="Sorter" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Background="{StaticResource PowerRow}"
                            BorderBrush="{StaticResource PowerBorderSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            ToolTip="Wird in den Einstellungen umgeschaltet">
                        <TextBlock Text="{Binding ModeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ModuleSorter}"/>
                    </Border>
                    <ComboBox ItemsSource="{Binding Filters}"
                              SelectedItem="{Binding Filter}"
                              MinWidth="168"
                              Margin="0,0,10,0"
                              AutomationProperties.Name="Dateien filtern"/>
                    <Button Command="{Binding ChooseSourceCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Startordner wählen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" Foreground="#F0B27A" Margin="0,0,7,0"/>
                            <TextBlock Text="Startordner"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource PowerRow}" BorderBrush="{StaticResource PowerBorderSoft}"
                            BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" ToolTip="{Binding BackupTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding BackupEnabled}" Margin="10,0,2,0" VerticalAlignment="Center"
                                      AutomationProperties.Name="Backup aktivieren"/>
                            <Button Command="{Binding ChooseBackupCommand}" IsEnabled="{Binding BackupEnabled}"
                                    Style="{StaticResource PowerGhostButton}" AutomationProperties.Name="Backup-Ordner wählen">
                                <TextBlock Text="{Binding BackupLabel}" MaxWidth="165" TextTrimming="CharacterEllipsis"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding RescanCommand}"
                            Style="{StaticResource PowerIconButton}"
                            Height="36"
                            Width="36"
                            Content="&#xE72C;"
                            ToolTip="Neu einlesen (F5)"
                            AutomationProperties.Name="Startordner neu einlesen"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Bühne und Zielbereiche ===================== -->
        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="368"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PowerCardStyle}" Padding="14">
                    <Border Background="{StaticResource PowerTerminal}" CornerRadius="9" ClipToBounds="True">
                        <Grid>
                            <!-- Leerzustand -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCurrent}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Margin="14" Stroke="#35404F" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="9" RadiusY="9"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                                    <Viewbox Width="50" Height="50" Margin="0,0,0,16">
                                        <Path Data="M 4,8 L 12,8 L 15,11 L 28,11 L 28,25 L 4,25 Z M 4,14 L 28,14"
                                              Stroke="#D7DCE5" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="Nichts zu sortieren" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SourceDisplay}"
                                               Style="{StaticResource MetaText}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,8,0,16"
                                               ToolTip="{Binding SourceDisplay}"/>
                                    <Button Command="{Binding ChooseSourceCommand}"
                                            Style="{StaticResource PowerPrimaryButton}"
                                            MinWidth="200"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="Startordner wählen">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                            <TextBlock Text="Startordner wählen"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Foto: nur das Bild -->
                            <Image Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   Margin="10"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"/>

                            <!-- Datei: keine Vorschau, nur Typ und Name -->
                            <Grid Visibility="{Binding IsPlainFile, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                                    <Border Background="#202934"
                                            BorderBrush="{StaticResource PowerBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Width="122"
                                            Height="122"
                                            HorizontalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7C3;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="38"
                                                       Foreground="{StaticResource PowerMuted}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentBadge}"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource ModuleSorter}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding CurrentName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,16,0,0"/>
                                    <TextBlock Text="Für diesen Dateityp gibt es keine Vorschau."
                                               Foreground="{StaticResource PowerMuted}"
                                               FontSize="12"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Video: derselbe Player wie in den übrigen Bereichen -->
                            <MediaElement x:Name="Player"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          Stretch="Uniform"
                                          Volume="{Binding Value, ElementName=VolumeSlider, Mode=OneWay}"
                                          MediaOpened="Player_MediaOpened"
                                          MediaEnded="Player_MediaEnded"
                                          MediaFailed="Player_MediaFailed"
                                          Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Aktuelle Datei, Wiedergabe und Navigation -->
                <Border Grid.Row="1" Style="{StaticResource PowerCardStyle}" Padding="16,13" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#202934"
                                    BorderBrush="{StaticResource PowerBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="0,0,11,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding CurrentBadge}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ModuleSorter}"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding CurrentName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentPath}"/>
                                <TextBlock Text="{Binding CurrentMeta}" Style="{StaticResource MetaText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CounterText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PowerMuted}"
                                       Margin="14,0,12,0"/>
                            <Button Grid.Column="3"
                                    Command="{Binding RevealCommand}"
                                    Style="{StaticResource PowerIconButton}"
                                    Content="&#xE8A7;"
                                    ToolTip="Im Explorer zeigen"
                                    AutomationProperties.Name="Datei im Explorer zeigen"/>
                        </Grid>

                        <!-- Wiedergabe nur bei Videos -->
                        <Grid Margin="0,12,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <Button Click="Play_Click" Style="{StaticResource TransportButton}" AutomationProperties.Name="Abspielen oder pausieren">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="PlayText" Text="Abspielen"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Click="Stop_Click" Style="{StaticResource TransportButton}" MinWidth="92" AutomationProperties.Name="Wiedergabe stoppen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="Stop"/>
                                </StackPanel>
                            </Button>
                            <Slider Grid.Column="2"
                                    x:Name="SeekSlider"
                                    Minimum="0"
                                    Maximum="1"
                                    Margin="8,0,12,0"
                                    VerticalAlignment="Center"
                                    ValueChanged="Seek_ValueChanged"
                                    AutomationProperties.Name="Wiedergabeposition"/>
                            <TextBlock Grid.Column="3"
                                       x:Name="TimeText"
                                       Text="00:00:00 / 00:00:00"
                                       Style="{StaticResource MetaText}"
                                       Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="4"
                                       Text="&#xE767;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{StaticResource PowerMuted}"
                                       Margin="0,0,8,0"/>
                            <Slider Grid.Column="5"
                                    x:Name="VolumeSlider"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0.5"
                                    VerticalAlignment="Center"
                                    ToolTip="Lautstärke"
                                    AutomationProperties.Name="Lautstärke"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Command="{Binding PreviousCommand}" Style="{StaticResource TransportButton}" MinWidth="126" AutomationProperties.Name="Vorherige Datei">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="Zurück"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SkipCommand}" Style="{StaticResource TransportButton}" MinWidth="150" AutomationProperties.Name="Datei überspringen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="Überspringen  (S)"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ReloadCommand}" Style="{StaticResource TransportButton}" MinWidth="140" AutomationProperties.Name="Datei neu laden">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="Neu laden  (L)"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding UndoCommand}" Style="{StaticResource TransportButton}" MinWidth="176" AutomationProperties.Name="Letzte Ablage rückgängig machen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="Rückgängig  (Strg+Z)"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Zielbereiche ===================== -->
            <Border Grid.Column="1" Style="{StaticResource PowerCardStyle}" Padding="14,13" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Zielbereiche" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="{Binding Targets.Count, StringFormat={}{0} Bereiche}"
                                       Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Taste drücken oder anklicken — die Datei wandert sofort in den Ordner."
                                   Foreground="{StaticResource PowerMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Targets}" Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TargetButton}"
                                                Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Folder}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource KeyCap}">
                                                    <TextBlock Text="{Binding KeyLabel}" Style="{StaticResource KeyCapText}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FolderText}"
                                                               Style="{StaticResource MetaText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CountText}"
                                                           Foreground="{StaticResource PowerSuccess}"
                                                           FontFamily="Consolas"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Noch keine Bereiche eingerichtet -->
                            <StackPanel VerticalAlignment="Center" Margin="4,20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTargets}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xED25;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="30"
                                           Foreground="{StaticResource PowerMuted}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Noch keine Zielbereiche"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="Lege in den Einstellungen fest, in welche Ordner sortiert werden soll. Die Tasten werden automatisch der Reihe nach vergeben."
                                           Foreground="{StaticResource PowerMuted}"
                                           FontSize="11.5"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,14"/>
                                <Button Click="OpenSettings_Click"
                                        Style="{StaticResource PowerPrimaryButton}"
                                        HorizontalAlignment="Center"
                                        MinWidth="200"
                                        AutomationProperties.Name="Einstellungen öffnen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                        <TextBlock Text="Bereiche einrichten"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="{StaticResource PowerTerminal}"
                            BorderBrush="{StaticResource PowerBorderSoft}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11,9"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Steuerung" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PowerMuted}" Margin="0,0,0,7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="Leertaste" Style="{StaticResource LegendText}" Foreground="{StaticResource PowerText}"/></Border>
                                <TextBlock Text="Video abspielen / pausieren" Style="{StaticResource LegendText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="&#x2190; &#x2192;" Style="{StaticResource LegendText}" Foreground="{StaticResource PowerText}"/></Border>
                                <TextBlock Text="Vorherige / nächste Datei" Style="{StaticResource LegendText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="S" Style="{StaticResource LegendText}" Foreground="{StaticResource PowerText}"/></Border>
                                <TextBlock Text="Überspringen" Style="{StaticResource LegendText}" Margin="0,0,10,0"/>
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="L" Style="{StaticResource LegendText}" Foreground="{StaticResource PowerText}"/></Border>
                                <TextBlock Text="Neu laden" Style="{StaticResource LegendText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="Strg+Z" Style="{StaticResource LegendText}" Foreground="{StaticResource PowerText}"/></Border>
                                <TextBlock Text="Rückgängig" Style="{StaticResource LegendText}" Margin="0,0,10,0"/>
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="F5" Style="{StaticResource LegendText}" Foreground="{StaticResource PowerText}"/></Border>
                                <TextBlock Text="Neu einlesen" Style="{StaticResource LegendText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Fußzeile ===================== -->
        <Border Grid.Row="2"
                Background="{StaticResource PowerSidebar}"
                BorderBrush="{StaticResource PowerBorderSoft}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MetaText}" Margin="0,0,14,0"/>
                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="1" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Status}"
                           FontSize="11.5"
                           Margin="16,0,16,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource PowerMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PowerDanger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="3"
                        Command="{Binding OpenSourceCommand}"
                        Style="{StaticResource PowerGhostButton}"
                        AutomationProperties.Name="Startordner im Explorer öffnen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding SourceDisplay}" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
