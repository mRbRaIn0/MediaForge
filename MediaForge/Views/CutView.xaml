<UserControl x:Class="MediaForge.Views.CutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MediaForge.Controls"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             Unloaded="OnUnloaded"
             Background="{StaticResource PowerBackground}">
    <UserControl.Resources>
        <Style x:Key="InButton" TargetType="Button" BasedOn="{StaticResource PowerButton}">
            <Setter Property="Background" Value="#22362E"/>
            <Setter Property="BorderBrush" Value="#3A6B55"/>
            <Setter Property="Foreground" Value="#6FD1A2"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="OutButton" TargetType="Button" BasedOn="{StaticResource PowerButton}">
            <Setter Property="Background" Value="#3A2530"/>
            <Setter Property="BorderBrush" Value="#5E3742"/>
            <Setter Property="Foreground" Value="{StaticResource ModuleCut}"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ViewHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource PowerGhostButton}"
                        AutomationProperties.Name="Zurück zum Hauptmenü">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                        <TextBlock Text="Hauptmenü"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border Width="3" Height="22" CornerRadius="2" Background="{StaticResource ModuleCut}" Margin="0,0,11,0"/>
                    <TextBlock Text="Cut" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Verlustfrei schneiden — Start und Ende setzen, exportieren"
                               Foreground="{StaticResource PowerMuted}" FontSize="11.5" Margin="12,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding ChooseFileCommand}"
                        Style="{StaticResource PowerButton}"
                        AutomationProperties.Name="Video wählen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#9EB9FF" Margin="0,0,7,0"/>
                        <TextBlock Text="Video wählen"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1020" Margin="16,14,16,16">

                <Border Style="{StaticResource PowerCardStyle}" Padding="16,14">
                    <StackPanel>
                        <Border Height="312" Background="{StaticResource PowerTerminal}" CornerRadius="9" ClipToBounds="True">
                            <Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Rectangle Margin="14" Stroke="#35404F" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="9" RadiusY="9"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="50" Height="50" Margin="0,0,0,16">
                                            <Path Data="M 6,7 L 26,7 L 26,25 L 6,25 Z M 6,12 L 26,12 M 6,20 L 26,20 M 11,7 L 11,25 M 21,7 L 21,25"
                                                  Stroke="#D7DCE5" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Viewbox>
                                        <TextBlock Text="Kein Video geladen" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Wähle eine Datei, um Vorschau und Zeitleiste zu laden."
                                                   Foreground="{StaticResource PowerMuted}" TextAlignment="Center" FontSize="12.5" Margin="0,7,0,16"/>
                                        <Button Command="{Binding ChooseFileCommand}"
                                                Style="{StaticResource PowerPrimaryButton}"
                                                MinWidth="180"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="Video wählen">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                                <TextBlock Text="Video wählen"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                                <MediaElement x:Name="Player"
                                              Visibility="Collapsed"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="Uniform"
                                              MediaEnded="Player_MediaEnded"/>
                            </Grid>
                        </Border>

                        <Grid Margin="2,12,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding MediaSummary}" Style="{StaticResource MetaText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="Play_Click" MinWidth="130" AutomationProperties.Name="Abspielen oder pausieren">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PlayText" Text="Abspielen"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Stop_Click" MinWidth="96" Margin="8,0,0,0" AutomationProperties.Name="Wiedergabe stoppen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                        <TextBlock Text="Stop"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource PowerTerminal}" BorderBrush="#333D49" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <controls:TimelineControl x:Name="Timeline"
                                                      Duration="{Binding Duration}"
                                                      Position="{Binding Position, Mode=TwoWay}"
                                                      InPoint="{Binding InPoint}"
                                                      OutPoint="{Binding OutPoint}"
                                                      Thumbnails="{Binding Thumbnails}"
                                                      SeekRequested="Timeline_SeekRequested"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Schnittbereich" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Command="{Binding SetInCommand}" Style="{StaticResource InButton}" AutomationProperties.Name="Startpunkt auf aktuelle Position setzen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,8,0"/>
                                    <TextBlock Text="Start hier  (I)"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetOutCommand}" Style="{StaticResource OutButton}" Margin="10,0,0,0" AutomationProperties.Name="Endpunkt auf aktuelle Position setzen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ende hier  (O)"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PowerCodeInput}" AutomationProperties.Name="Startzeit"/>
                            <TextBlock Grid.Column="2" Text="Ende" Style="{StaticResource FieldLabel}" Margin="14,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PowerCodeInput}" AutomationProperties.Name="Endzeit"/>
                            <Button Grid.Column="4" Command="{Binding ApplyTimesCommand}" Content="Übernehmen" Margin="10,0,0,0" AutomationProperties.Name="Zeiten übernehmen"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SizeEstimate}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Geschätzte Größe" Style="{StaticResource FieldLabel}" Margin="0,0,9,0"/>
                                <Border Background="{StaticResource PowerRow}" BorderBrush="{StaticResource PowerBorderSoft}" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                    <TextBlock Text="{Binding SizeEstimate}" Foreground="{StaticResource BlueBrush}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Ausgabe &amp; Export" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dateiname" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dateiname der Ausgabe"/>
                            <CheckBox Grid.Column="2"
                                      Content="Exakter Schnitt (neu encodieren)"
                                      IsChecked="{Binding Exact}"
                                      Margin="16,0,0,0"
                                      ToolTip="Schneidet framegenau, dauert aber länger"
                                      AutomationProperties.Name="Exakter Schnitt mit Neuencodierung"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zielordner" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding OutputFolder}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolder}"/>
                            <Button Grid.Column="2" Command="{Binding ChooseFolderCommand}" Content="Ordner wählen" Margin="16,0,0,0" AutomationProperties.Name="Zielordner wählen"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding ExportCommand}" Style="{StaticResource PowerPrimaryButton}" AutomationProperties.Name="Schnitt exportieren">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                    <TextBlock Text="Exportieren"/>
                                </StackPanel>
                            </Button>
                            <ProgressBar Grid.Column="1" Style="{StaticResource PowerProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="16,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource PowerMuted}" FontSize="11.5"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
