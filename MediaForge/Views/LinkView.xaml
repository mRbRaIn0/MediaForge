<UserControl x:Class="MediaForge.Views.LinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PowerBackground}"
             KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ViewHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource PowerGhostButton}"
                        AutomationProperties.Name="Zurück zum Hauptmenü">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                        <TextBlock Text="Hauptmenü"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border Width="3" Height="22" CornerRadius="2" Background="{StaticResource ModuleLink}" Margin="0,0,11,0"/>
                    <TextBlock Text="Link" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Mehrere Videos in dieser Reihenfolge zu einem verbinden"
                               Foreground="{StaticResource PowerMuted}" FontSize="11.5" Margin="12,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding AddFilesCommand}"
                        Style="{StaticResource PowerButton}"
                        AutomationProperties.Name="Dateien hinzufügen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#9EB9FF" Margin="0,0,7,0"/>
                        <TextBlock Text="Dateien hinzufügen"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PowerCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Videoliste" FontWeight="SemiBold" FontSize="14"/>
                        <Border Grid.Column="1" Background="{StaticResource PowerRow}" CornerRadius="5" Padding="8,3" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Items.Count}" Foreground="{StaticResource PowerMuted}" FontFamily="Consolas" FontSize="10.5"/>
                        </Border>
                        <TextBlock Grid.Column="3" Text="{Binding ModeText}" Foreground="{StaticResource PowerWarning}" FontSize="11.5" FontWeight="SemiBold"/>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource PowerBorderSoft}" BorderThickness="0,1,0,0">
                        <Grid Margin="16,10,16,16">
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Stroke="#35404F" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="11" RadiusY="11"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Viewbox Width="54" Height="54" Margin="0,0,0,18">
                                        <Path Data="M 13,19 L 19,13 M 11,9 L 14,6 A 5.5,5.5 0 0 1 22,14 L 19,17 M 21,23 L 18,26 A 5.5,5.5 0 0 1 10,18 L 13,15"
                                              Stroke="#D7DCE5" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="Noch keine Videos ausgewählt" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Die Reihenfolge in dieser Liste ist die Reihenfolge im&#x0a;fertigen Video — oben beginnt, unten endet."
                                               Foreground="{StaticResource PowerMuted}"
                                               TextAlignment="Center"
                                               LineHeight="20"
                                               FontSize="12.5"
                                               Margin="0,8,0,18"/>
                                    <Button Command="{Binding AddFilesCommand}"
                                            Style="{StaticResource PowerLinkButton}"
                                            Padding="15,8"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="Dateien hinzufügen">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="#6F9AFF" Margin="0,0,7,0"/>
                                            <TextBlock Text="Videos hinzufügen" Foreground="#6F9AFF"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding Items}"
                                     AlternationCount="99"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PowerRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{StaticResource ModuleLink}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource OneBasedIndex}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="7,0,12,0" ToolTip="{Binding FilePath}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Meta}" Style="{StaticResource MetaText}" HorizontalAlignment="Center"/>
                                                <Button Grid.Column="3"
                                                        Content="&#xE70E;"
                                                        Style="{StaticResource PowerIconButton}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Nach oben schieben"
                                                        AutomationProperties.Name="Video nach oben schieben"/>
                                                <Button Grid.Column="4"
                                                        Content="&#xE70D;"
                                                        Style="{StaticResource PowerIconButton}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Nach unten schieben"
                                                        AutomationProperties.Name="Video nach unten schieben"/>
                                                <Button Grid.Column="5"
                                                        Content="&#xE74D;"
                                                        Style="{StaticResource PowerIconDangerButton}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Aus der Liste entfernen"
                                                        AutomationProperties.Name="Video aus der Liste entfernen"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Ausgabe &amp; Verbinden" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dateiname" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dateiname der Ausgabe"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Zielordner" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding OutputFolder}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolder}"/>
                        <Button Grid.Column="2" Command="{Binding ChooseFolderCommand}" Content="Ordner wählen" Margin="16,0,0,0" AutomationProperties.Name="Zielordner wählen"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding JoinCommand}" Style="{StaticResource PowerPrimaryButton}" AutomationProperties.Name="Videos verbinden">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="Verbinden"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar Grid.Column="1" Style="{StaticResource PowerProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource PowerMuted}" FontSize="11.5"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
