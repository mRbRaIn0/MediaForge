<UserControl x:Class="MediaForge.Views.SpeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MediaForge.Controls"
             Unloaded="OnUnloaded"
             Background="{StaticResource PowerBackground}">
    <UserControl.Resources>
        <Style x:Key="InButton" TargetType="Button" BasedOn="{StaticResource PowerButton}">
            <Setter Property="Background" Value="#22362E"/>
            <Setter Property="BorderBrush" Value="#3A6B55"/>
            <Setter Property="Foreground" Value="#6FD1A2"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="OutButton" TargetType="Button" BasedOn="{StaticResource PowerButton}">
            <Setter Property="Background" Value="#3A2530"/>
            <Setter Property="BorderBrush" Value="#5E3742"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ViewHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource PowerGhostButton}"
                        AutomationProperties.Name="Zurück zum Hauptmenü">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                        <TextBlock Text="Hauptmenü"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border Width="3" Height="22" CornerRadius="2" Background="{StaticResource ModuleSpeed}" Margin="0,0,11,0"/>
                    <TextBlock Text="Speed Zone" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Abschnitte schneller oder langsamer abspielen lassen"
                               Foreground="{StaticResource PowerMuted}" FontSize="11.5" Margin="12,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding ChooseFileCommand}"
                        Style="{StaticResource PowerButton}"
                        AutomationProperties.Name="Video wählen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#9EB9FF" Margin="0,0,7,0"/>
                        <TextBlock Text="Video wählen"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1020" Margin="16,14,16,16">

                <Border Style="{StaticResource PowerCardStyle}" Padding="16,14">
                    <StackPanel>
                        <Border Height="276" Background="{StaticResource PowerTerminal}" CornerRadius="9" ClipToBounds="True">
                            <Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Rectangle Margin="14" Stroke="#35404F" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="9" RadiusY="9"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="50" Height="50" Margin="0,0,0,16">
                                            <Path Data="M 5,16 L 13,16 M 16,6 A 10,10 0 1 1 15.9,6 M 16,16 L 16,9 M 16,16 L 21,20"
                                                  Stroke="#D7DCE5" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Viewbox>
                                        <TextBlock Text="Kein Video geladen" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Wähle eine Datei und markiere danach die Abschnitte,&#x0a;die schneller oder langsamer laufen sollen."
                                                   Foreground="{StaticResource PowerMuted}" TextAlignment="Center" LineHeight="19" FontSize="12.5" Margin="0,7,0,16"/>
                                        <Button Command="{Binding ChooseFileCommand}"
                                                Style="{StaticResource PowerPrimaryButton}"
                                                MinWidth="180"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="Video wählen">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                                <TextBlock Text="Video wählen"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                                <MediaElement x:Name="Player"
                                              Visibility="Collapsed"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="Uniform"
                                              MediaEnded="Player_MediaEnded"/>
                            </Grid>
                        </Border>

                        <Grid Margin="2,12,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding MediaSummary}" Style="{StaticResource MetaText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="Play_Click" MinWidth="168" AutomationProperties.Name="Vorschau mit Tempo abspielen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PlayText" Text="Vorschau (Tempo)"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Stop_Click" MinWidth="96" Margin="8,0,0,0" AutomationProperties.Name="Wiedergabe stoppen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                        <TextBlock Text="Stop"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource PowerTerminal}" BorderBrush="#333D49" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <controls:TimelineControl Duration="{Binding Duration}"
                                                      Position="{Binding Position, Mode=TwoWay}"
                                                      InPoint="{Binding PendingIn}"
                                                      OutPoint="{Binding PendingOut}"
                                                      Thumbnails="{Binding Thumbnails}"
                                                      Zones="{Binding Zones}"
                                                      SeekRequested="Timeline_SeekRequested"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="430"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="Neue Zone" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <Button Command="{Binding SetStartCommand}" Style="{StaticResource InButton}" Content="Start hier  (I)" AutomationProperties.Name="Zonenstart auf aktuelle Position setzen"/>
                                <Button Command="{Binding SetEndCommand}" Style="{StaticResource OutButton}" Content="Ende hier  (O)" Margin="10,0,0,0" AutomationProperties.Name="Zonenende auf aktuelle Position setzen"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding PendingStart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PowerCodeInput}" AutomationProperties.Name="Startzeit der Zone"/>
                                <TextBlock Grid.Column="2" Text="Ende" Style="{StaticResource FieldLabel}" Margin="13,0,8,0"/>
                                <TextBox Grid.Column="3" Text="{Binding PendingEnd, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PowerCodeInput}" AutomationProperties.Name="Endzeit der Zone"/>
                                <TextBlock Grid.Column="4" Text="Faktor" Style="{StaticResource FieldLabel}" Margin="13,0,8,0"/>
                                <ComboBox Grid.Column="5" IsEditable="True" ItemsSource="{Binding Factors}" Text="{Binding Factor}" AutomationProperties.Name="Tempofaktor"/>
                            </Grid>
                            <Button Command="{Binding AddZoneCommand}" HorizontalAlignment="Left" MinWidth="190" Margin="0,11,0,0" AutomationProperties.Name="Zone hinzufügen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ModuleSpeed}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Zone hinzufügen"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="5,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <TextBlock Text="Zonen" FontSize="13.5" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource PowerRow}" CornerRadius="5" Padding="8,3" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Zones.Count}" Foreground="{StaticResource PowerMuted}" FontFamily="Consolas" FontSize="10.5"/>
                                </Border>
                            </StackPanel>
                            <Grid Grid.Row="1">
                            <TextBlock Text="Noch keine Zone angelegt — Start und Ende setzen, Faktor wählen, hinzufügen."
                                       Foreground="{StaticResource PowerMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Zones.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding Zones}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PowerRowStyle}" Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="3" Height="16" CornerRadius="2" Background="{StaticResource ModuleSpeed}" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="Consolas" FontSize="11"/>
                                                <Button Grid.Column="2"
                                                        Content="&#xE74D;"
                                                        Style="{StaticResource PowerIconDangerButton}"
                                                        Command="{Binding DataContext.RemoveZoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Zone entfernen"
                                                        AutomationProperties.Name="Zone entfernen"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource PowerCardStyle}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Ausgabe &amp; Export" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dateiname" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dateiname der Ausgabe"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zielordner" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding OutputFolder}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolder}"/>
                            <Button Grid.Column="2" Command="{Binding ChooseFolderCommand}" Content="Ordner wählen" Margin="16,0,0,0" AutomationProperties.Name="Zielordner wählen"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding ExportCommand}" Style="{StaticResource PowerPrimaryButton}" AutomationProperties.Name="Video mit Tempozonen exportieren">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                    <TextBlock Text="Exportieren"/>
                                </StackPanel>
                            </Button>
                            <ProgressBar Grid.Column="1" Style="{StaticResource PowerProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="16,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource PowerMuted}" FontSize="11.5"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
